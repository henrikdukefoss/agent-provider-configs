{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "myprovider/MODEL_ID",
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Provider",
      "options": {
        "baseURL": "https://YOUR_PROVIDER/v1",
        "apiKey": "{env:YOUR_PROVIDER_API_KEY}"
      },
      "models": {
        "MODEL_ID": {
          "name": "My model",
          "tool_call": true,
          "limit": { "context": 128000, "output": 16384 }
        }
      }
    }
  }
}
